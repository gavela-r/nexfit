# Puerto del servidor API
PORT=4000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Carpeta con el build del frontend (opcional, para servir la SPA desde el backend)
# Relativa a la ubicación de app.ts (src o dist)
# FRONTEND_DIST=../../frontend/dist

# --- MySQL (toda la persistencia del proyecto) ------------------------------
# Con Docker la base se publica en localhost:3307.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=nexfit
DB_USER=nexfit
DB_PASSWORD=nexfit_pass

# Conexiones simultáneas del pool y reintentos de arranque
DB_POOL=10
DB_RETRIES=15

# --- Stripe (pago con tarjeta) ----------------------------------------------
# Claves de PRUEBA del panel de Stripe: https://dashboard.stripe.com/test/apikeys
# Sin STRIPE_SECRET_KEY el botón «Tramitar Pedido» responde que el pago no está configurado.
STRIPE_SECRET_KEY=
# Opcional: firma del webhook (`stripe listen` la muestra al arrancar).
STRIPE_WEBHOOK_SECRET=
# Opcional: URL pública de la tienda a la que vuelve Stripe tras pagar.
# Si se deja vacía se usa el origen de la petición (p. ej. http://localhost:5173).
APP_URL=
