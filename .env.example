# Valores por defecto del stack Docker (docker-compose.yml).
# Copia este fichero como «.env» si quieres cambiarlos:
#
#   Copy-Item .env.example .env      (Windows)
#   cp .env.example .env             (Linux/macOS)
#
# .env está excluido del control de versiones.

# --- MySQL -----------------------------------------------------------------
MYSQL_ROOT_PASSWORD=nexfit_root
MYSQL_DATABASE=nexfit
MYSQL_USER=nexfit
MYSQL_PASSWORD=nexfit_pass

# --- Puertos publicados en tu equipo ---------------------------------------
DB_PORT=3307
BACKEND_PORT=4000
FRONTEND_PORT=8080

# --- CORS del backend ------------------------------------------------------
# El frontend habla con la API a través de Nginx (mismo origen), así que solo
# hace falta para llamadas directas al puerto 4000 desde el navegador.
CORS_ORIGIN=http://localhost:8080,http://localhost:5173,http://localhost:4173
